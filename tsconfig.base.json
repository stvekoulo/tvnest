{
    "compileOnSave": false,
    "compilerOptions": {
        "rootDir": ".",
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "node",
        "esModuleInterop": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "isolatedModules": true,
        "importHelpers": true,
        "target": "es2020",
        "module": "esnext",
        "lib": ["es2022", "dom"],
        "skipLibCheck": true,
        "skipDefaultLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@iptvnator/shared/m3u-utils": [
                "libs/shared/m3u-utils/src/index.ts"
            ],
            "@iptvnator/shared/logging": ["libs/shared/logging/src/index.ts"],
            "@iptvnator/shared/host-health": [
                "libs/shared/host-health/src/index.ts"
            ],
            "@iptvnator/shared/interfaces": [
                "libs/shared/interfaces/src/index.ts"
            ],
            "@iptvnator/shared/interfaces/xtream-restore-state": [
                "libs/shared/interfaces/src/lib/xtream-restore-state.util.ts"
            ],
            "@iptvnator/shared/interfaces/ipc-commands": [
                "libs/shared/interfaces/src/lib/ipc-commands.ts"
            ],
            "@iptvnator/shared/interfaces/zoom-level": [
                "libs/shared/interfaces/src/lib/zoom-level.util.ts"
            ],
            "@iptvnator/shared/database": ["libs/shared/database/src/index.ts"],
            "@iptvnator/shared/database/schema": [
                "libs/shared/database/src/lib/schema.ts"
            ],
            "@iptvnator/shared/database/app-playlist": [
                "libs/shared/database/src/lib/app-playlist.ts"
            ],
            "@iptvnator/shared/database/path-utils": [
                "libs/shared/database/src/lib/path-utils.ts"
            ],
            "@iptvnator/shared/database/connection-observer": [
                "libs/shared/database/src/lib/connection-observer.ts"
            ],
            "@package": ["./package.json"]
        },
        "strict": false,
        "noUncheckedSideEffectImports": false,
        "types": ["*"],
        "ignoreDeprecations": "6.0"
    },
    "exclude": ["node_modules", "tmp"],
    "files": ["global.d.ts"]
}
